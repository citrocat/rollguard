#!/usr/bin/env node
/* Enforces RollGuard's Conventional Commits + detailed Chinese body policy. */
"use strict";

const fs = require("node:fs");

const file = process.argv[2];
if (!file) process.exit(0);

const raw = fs.readFileSync(file, "utf8");
const cleaned = raw
  .split("\n")
  .filter((line) => !line.trimStart().startsWith("#"))
  .join("\n")
  .trim();

if (!cleaned) {
  console.error("\nRollGuard commit policy: commit message is empty.\n");
  process.exit(1);
}

const lines = cleaned.split("\n");
const header = lines[0].trim();
const typePattern =
  /^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([A-Za-z0-9._-]+\))?: .+$/;
const hasChinese = /[\u3400-\u9fff]/;

function fail(message) {
  console.error(`\nRollGuard commit policy: ${message}\n`);
  console.error("请使用以下形式：\n");
  console.error("  feat(scope): 中文摘要\n");
  console.error("  - 改了什么，以及为什么这样改。");
  console.error("  - 另一个具体改动，以及它解决的问题。\n");
  process.exit(1);
}

if (!typePattern.test(header)) {
  fail("header 必须是 `<type>(<scope>): <中文摘要>`，type 需为 Conventional Commits 允许的类型。");
}
if (!hasChinese.test(header)) {
  fail("commit 摘要必须使用中文。");
}
if (lines.length < 4) {
  fail("commit 必须多行：header、空行、至少两行正文。");
}
if (lines[1].trim() !== "") {
  fail("header 后必须有一个空行，再接正文。");
}

const bodyLines = lines.slice(2).filter((line) => line.trim() !== "");
const body = bodyLines.join("\n");
if (bodyLines.length < 2) {
  fail("正文至少需要两条改动说明。");
}
if (!hasChinese.test(body)) {
  fail("正文必须使用中文。");
}

const bullets = bodyLines.filter((line) => /^[-*]\s+\S/.test(line.trim()));
if (bullets.length < 2) {
  fail("正文至少需要两条以 `- ` 开头的条目，分别说明改动与理由。");
}

if (/^(co-authored-by|signed-off-by|change-id|generated-by):/im.test(body)) {
  fail("正文只能包含改动描述与理由，不要添加自动生成或其他无关 trailer。");
}
if (/generated\s+(with|by)|ai[- ]generated|🤖/i.test(body)) {
  fail("正文不要包含 AI 生成声明或无关标记。");
}

process.exit(0);
